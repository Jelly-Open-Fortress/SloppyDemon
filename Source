local allowedNames = {
    ["Floppy Disc Drive"] = true,
    ["FloppyDiscPickup"] = true
}


local function isAllowed(prompt)
    local ancestor = prompt.Parent
    while ancestor and ancestor ~= game do
        if allowedNames[ancestor.Name] then
            return true
        end
        ancestor = ancestor.Parent
    end
    return false
end


for _, v in ipairs(game:GetDescendants()) do
    if v:IsA("ProximityPrompt") then
        if not isAllowed(v) then
            v:Destroy()
        end
    end
end


local workspaceConnection
workspaceConnection = workspace.DescendantAdded:Connect(function(v)
    if v:IsA("ProximityPrompt") then
        
        task.defer(function()
            if v and v.Parent and not isAllowed(v) then
                v:Destroy()
            end
        end)
    end
end)

local POS_1 = Vector3.new(-16, -33, 6)
local POS_2 = Vector3.new(91, 3, -20)
local WAIT_TIME = 20
local EQUIP_DELAY = 0.5 


local Players = game:GetService("Players")
local Player = Players.LocalPlayer


local function teleport(position)
    local character = Player.Character or Player.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart", 5)
    if rootPart then
        rootPart.CFrame = CFrame.new(position)
    end
end


local function equipAllTools()
    local character = Player.Character or Player.CharacterAdded:Wait()
    local backpack = Player:WaitForChild("Backpack", 5)
    
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                tool.Parent = character
            end
        end
    end
end


local function isInventoryEmpty()
    local character = Player.Character
    local backpack = Player:FindFirstChild("Backpack")

    if backpack and #backpack:GetChildren() > 0 then
        return false
    end
    

    if character then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") then
                return false
            end
        end
    end
    
    return true
end


task.spawn(function()
    while true do
     
        teleport(POS_1)
        task.wait(WAIT_TIME)
        
   
        teleport(POS_2)
        
       
        task.wait(EQUIP_DELAY)
        
      
        equipAllTools()
        
        task.wait(WAIT_TIME)
        
      
        if not isInventoryEmpty() then
            print("Tools detected. Pausing loop until inventory is empty...")
            repeat
                task.wait(0.5)
            until isInventoryEmpty() 
            print("Inventory empty. Restarting farm loop...")
        end
    end
end)
