-- Configuration Settings
local TOGGLE_KEY = Enum.KeyCode.R
local SPAM_KEY = Enum.KeyCode.F
local SECOND_KEY = Enum.KeyCode.E
local UNLOAD_KEY = Enum.KeyCode.Insert -- Added Unload Key
local SPAM_SECOND_KEY = true 
local HOLD_TIME = 0.01
local DELAY_BETWEEN = 0

-- Services
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

-- Global State
local _G = getgenv and getgenv() or _G
_G.SpammerActive = true
_G.ScriptRunning = true -- Variable to safely kill loops

-- Connection Tracking for Clean Unload
local Connections = {}

-- Thread 1: Automated Loops
task.spawn(function()
    local areaEvent = ReplicatedStorage:WaitForChild("Events"):WaitForChild("AreaChangeEvent")
    local args = { "Spawn", false }
    while _G.ScriptRunning do
        local interactables = workspace:FindFirstChild("Interactables")
        if interactables then
            for _, drive in ipairs(interactables:GetChildren()) do
                if drive.Name == "Floppy Disc Drive" then
                    if drive:FindFirstChild("Base") and drive.Base:FindFirstChild("Attachment") and drive.Base.Attachment:FindFirstChild("Prompt") then
                        drive.Base.Attachment.Prompt.Enabled = true
                    end
                end
            end
        end

        if interactables and interactables:FindFirstChild("FloppyDiscPickups") then
            for _, disc in ipairs(interactables.FloppyDiscPickups:GetChildren()) do
                if disc:FindFirstChild("Handle") and disc.Handle:FindFirstChild("ProximityPrompt") then
                    disc.Handle.ProximityPrompt.Enabled = true
                end
            end
        end

        areaEvent:FireServer(unpack(args))
        task.wait(0.1)
    end
end)

-- Thread 2: Keybind Toggle & Unload Listener
local inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    -- Handle Spammer Toggle
    if input.KeyCode == TOGGLE_KEY and _G.ScriptRunning then
        _G.SpammerActive = not _G.SpammerActive
        print("Spammer Status: " .. (_G.SpammerActive and "ENABLED" or "DISABLED"))
    
    -- Handle Script Unload
    elseif input.KeyCode == UNLOAD_KEY then
        _G.ScriptRunning = false
        _G.SpammerActive = false
        
        -- Disconnect all events
        for _, conn in ipairs(Connections) do
            if conn then conn:Disconnect() end
        end
        
        if execCmd then execCmd("instantproximityprompts") end -- Revert exploit cmd if applicable
        print("Fully Unloaded")
    end
end)
table.insert(Connections, inputConnection)

-- Thread 3: Key Spammer Action
task.spawn(function()
    while _G.ScriptRunning do
        if _G.SpammerActive then
            VirtualInputManager:SendKeyEvent(true, SPAM_KEY, false, game)
            if SPAM_SECOND_KEY then VirtualInputManager:SendKeyEvent(true, SECOND_KEY, false, game) end
            task.wait(HOLD_TIME)
            
            VirtualInputManager:SendKeyEvent(false, SPAM_KEY, false, game)
            if SPAM_SECOND_KEY then VirtualInputManager:SendKeyEvent(false, SECOND_KEY, false, game) end
            task.wait(DELAY_BETWEEN)
        else
            task.wait(0.1)
        end
    end
end)

-- Bot automation
local player = game:GetService("Players").LocalPlayer
if player then
    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA('Tool') or item:IsA('HopperBin') then item:Destroy() end
        end
    end
    local character = player.Character
    if character then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA('Tool') or item:IsA('HopperBin') then item:Destroy() end
        end
    end
end

if fireproximityprompt then
    if execCmd then execCmd("uninstantproximityprompts") end
    local promptHoldConnection = ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
        if _G.ScriptRunning then fireproximityprompt(prompt) end
    end)
    table.insert(Connections, promptHoldConnection)
else
    if notify then notify('Incompatible Exploit','Your exploit does not support this command') else print('Incompatible Exploit') end
end

local allowedNames = { ["Floppy Disc Drive"] = true, ["FloppyDiscPickup"] = true }
local function isAllowed(prompt)
    local ancestor = prompt.Parent
    while ancestor and ancestor ~= game do
        if allowedNames[ancestor.Name] then return true end
        ancestor = ancestor.Parent
    end
    return false end

for _, v in ipairs(game:GetDescendants()) do
    if v:IsA("ProximityPrompt") then
        if not isAllowed(v) then v:Destroy() end
    end
end

local workspaceConnection = workspace.DescendantAdded:Connect(function(v)
    if v:IsA("ProximityPrompt") then
        task.defer(function()
            if v and v.Parent and not isAllowed(v) then v:Destroy() end
        end)
    end
end)
table.insert(Connections, workspaceConnection)

local POS_1 = Vector3.new(-16, -33, 6)
local POS_2 = Vector3.new(91, 3, -20)
local WAIT_TIME = 20
local EQUIP_DELAY = 0.5
local Players = game:GetService("Players")
local Player = Players.LocalPlayer

local function teleport(position)
    local character = Player.Character or Player.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart", 5)
    if rootPart then rootPart.CFrame = CFrame.new(position) end
end

local function equipAllTools()
    local character = Player.Character or Player.CharacterAdded:Wait()
    local backpack = Player:WaitForChild("Backpack", 5)
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then tool.Parent = character end
        end
    end
end

local function isInventoryEmpty()
    local character = Player.Character
    local backpack = Player:FindFirstChild("Backpack")
    if backpack and #backpack:GetChildren() > 0 then return false end
    if character then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") then return false end
        end
    end
    return true
end

-- Thread 4: Teleport Loop
task.spawn(function()
    while _G.ScriptRunning do
        teleport(POS_1)
        task.wait(WAIT_TIME)
        if not _G.ScriptRunning then break end
        
        teleport(POS_2)
        task.wait(EQUIP_DELAY)
        equipAllTools()
        task.wait(WAIT_TIME)
        
        if not isInventoryEmpty() and _G.ScriptRunning then
            print("Tools detected. Pausing loop until inventory is empty...")
            repeat task.wait(0.5) until isInventoryEmpty() or not _G.ScriptRunning
            if _G.ScriptRunning then print("Inventory empty. Restarting farm loop...") end
        end
    end
end)
